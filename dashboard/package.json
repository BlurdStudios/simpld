{
  "name": "simpld-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vendor-hosted read-only dashboard for Simpld sites. Outbound-push only; no live factory queries.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "smoke": "node --import ./scripts/register-hooks.mjs scripts/smoke.ts",
    "test": "npm run smoke"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.121.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.121.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^3.90.0"
  }
}
